{
  "schemaVersion": "1.0",
  "meta": {
    "id": "douyin",
    "name": "抖音",
    "author": "vi-ump",
    "version": "1.0.0",
    "color": "#161823",
    "description": "只要「推荐」一栏。接口是网页版 tab/feed，请求前由客户端补 a_bogus 签名与 msToken/ttwid 设备 cookie（request.sign=douyin）——不带签名的请求会被直接回 7 字节 blocked。推荐流没有游标，翻页靠递增 refresh_index，每页 2~10 条且每次都是新推荐。本源没有详情页：抖音的单条详情接口（aweme/detail）强制校验 uifid（返回 403 Blocked by ArgusSecurityPlugin），所以卡片直接把 feed 里的 play_addr 当播放地址，点开即播。"
  },
  "runtime": {
    "baseUrl": "https://www.douyin.com",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0",
      "Accept": "application/json, text/plain, */*",
      "Accept-Language": "zh-CN,zh;q=0.9",
      "Referer": "https://www.douyin.com/?recommend=1"
    },
    "encoding": "utf-8",
    "timeoutMs": 20000,
    "retry": 1
  },
  "resources": {
    "feeds": {
      "recommend": {
        "request": {
          "method": "GET",
          "url": "{{baseUrl}}/aweme/v1/web/tab/feed/?device_platform=webapp&aid=6383&channel=channel_pc_web&pc_client_type=1&version_code=190500&version_name=19.5.0&cookie_enabled=true&screen_width=1920&screen_height=1080&browser_language=zh-CN&browser_platform=Win32&browser_name=Edge&browser_version=130.0.0.0&browser_online=true&engine_name=Blink&engine_version=130.0.0.0&os_name=Windows&os_version=10&cpu_core_num=12&device_memory=8&platform=PC&downlink=10&effective_type=4g&round_trip_time=50&count=20&video_type_select=1&aweme_pc_rec_raw=1&pull_type=0&refresh_index={{refresh_index}}",
          "sign": "douyin"
        },
        "fields": {
          "id": { "kind": "jsonPath", "from": "$.aweme_id", "required": true },
          "title": { "kind": "jsonPath", "from": "$.desc", "required": true },
          "poster": { "kind": "jsonPath", "from": "$.video.cover.url_list[0]" },
          "subtitle": { "kind": "jsonPath", "from": "$.author.nickname" },
          "playUrl": { "kind": "jsonPath", "from": "$.video.play_addr.url_list[-1]" },
          "kind": { "kind": "const", "from": "video" }
        },
        "list": "$.aweme_list[*]",
        "paging": {
          "mode": "page",
          "param": "refresh_index",
          "startAt": 1,
          "step": 1,
          "maxPage": 5,
          "hasMore": "$.has_more"
        }
      }
    }
  },
  "pages": [
    {
      "id": "home",
      "title": "抖音推荐",
      "layout": { "type": "poster_grid", "columns": 3, "ratio": "9:16", "gap": 10 },
      "feed": "recommend",
      "card": {
        "style": "poster",
        "image": "poster",
        "title": "title",
        "subtitle": "subtitle",
        "ratio": "9:16",
        "action": { "type": "detail" }
      }
    }
  ],
  "playback": {
    "strategy": "direct",
    "headers": {
      "Referer": "https://www.douyin.com/",
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0"
    }
  },
  "theme": {
    "mode": "dark",
    "primary": "#161823",
    "background": "#0B0B0F",
    "surface": "#161823",
    "onSurface": "#F2F2F5",
    "accent": "#FE2C55",
    "cornerRadius": 10,
    "density": "comfortable",
    "posterColumns": 3,
    "fontScale": 1.0
  },
  "flags": {
    "enableSearch": false,
    "enableHistory": true,
    "enableFavorite": true
  }
}

