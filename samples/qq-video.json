{
  "schemaVersion": "1.0",
  "meta": {
    "id": "qq-video",
    "name": "腾讯视频",
    "author": "vi-ump-samples",
    "version": "1.1.0",
    "color": "#FF6B35",
    "description": "栏目数据取自频道页 SSR 预置数据（window.__vikor__context__ 里的 focusList）：正文是 JS 对象字面量，所以用 responseType=text + listSplit 按花括号锚点切片，再用 regex 取 cid/sourceTitle/smallCoverPic/subTitle。锚点必须带花括号，否则 cid:XXXX 里的 id: 会把一条切成两段。列表 id 是 cid（专辑 id），详情走 vv.video.qq.com/getinfo?vids=&cid={cid} 取第一集的 vid/fn/fvkey 拼直链。分页实测（三组对照，均已复跑）：① channel/tv 不带参数 / ?offset=15 / ?offset=0&pagesize=30 返回的 cid 集合完全相同（各 15 条）；② channel/choice?page=1 与 ?page=2 完全相同（各 14 条），?page=3 相对 page=1 才有 2 条不同 —— 这不是分页，是 SSR 里推荐位的随机漂移；③ x/bu/pagesheet/list 两种形式都是 404，带签名的频道分页接口不在本示例范围内。所以这三个栏目没有真正的翻页，只有首屏 14~15 条（每次请求可能有 0~2 条浮动）。这里仍写 maxPage:5：一来保留“站点哪天给了可用分页参数就能直接用”的余地，二来运行时由首页的“整页都是已加载过的条目即视为到底”兜住（实测第 2 页 14 条只新增 1 条、第 3 页新增 0 条即停），不会把同一批内容重复追加。"
  },
  "runtime": {
    "baseUrl": "https://v.qq.com",
    "imageBase": "https://puui.qpic.cn",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
      "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8",
      "Referer": "https://v.qq.com/"
    },
    "encoding": "utf-8",
    "timeoutMs": 20000,
    "retry": 2,
    "proxyBypass": ["qq.com", "qqvideo.com", "gtimg.com", "qpic.cn"]
  },
  "resources": {
    "feeds": {
      "channelChoice": {
        "request": {
          "method": "GET",
          "url": "https://v.qq.com/channel/choice"
        },
        "responseType": "text",
        "listSplit": "(?s)\\{id:\"mzc[0-9a-z]+\",.*?(?=\\{id:\"mzc[0-9a-z]+\",|$)",
        "fields": {
          "id": { "kind": "regex", "pattern": "cid:\"(mzc[0-9a-z]+)\"", "group": 1 },
          "title": { "kind": "regex", "pattern": "sourceTitle:\"([^\"]+)\"", "group": 1 },
          "poster": { "kind": "regex", "pattern": "smallCoverPic:\"([^\"]+)\"", "group": 1 },
          "subtitle": { "kind": "regex", "pattern": "subTitle:\"([^\"]+)\"", "group": 1 },
          "kind": { "kind": "const", "from": "video" }
        },
        "paging": { "mode": "page", "maxPage": 5 }
      },
      "channelTv": {
        "request": {
          "method": "GET",
          "url": "https://v.qq.com/channel/tv"
        },
        "responseType": "text",
        "listSplit": "(?s)\\{id:\"mzc[0-9a-z]+\",.*?(?=\\{id:\"mzc[0-9a-z]+\",|$)",
        "fields": {
          "id": { "kind": "regex", "pattern": "cid:\"(mzc[0-9a-z]+)\"", "group": 1 },
          "title": { "kind": "regex", "pattern": "sourceTitle:\"([^\"]+)\"", "group": 1 },
          "poster": { "kind": "regex", "pattern": "smallCoverPic:\"([^\"]+)\"", "group": 1 },
          "subtitle": { "kind": "regex", "pattern": "subTitle:\"([^\"]+)\"", "group": 1 },
          "kind": { "kind": "const", "from": "video" }
        },
        "paging": { "mode": "page", "maxPage": 5 }
      },
      "channelMovie": {
        "request": {
          "method": "GET",
          "url": "https://v.qq.com/channel/movie"
        },
        "responseType": "text",
        "listSplit": "(?s)\\{id:\"mzc[0-9a-z]+\",.*?(?=\\{id:\"mzc[0-9a-z]+\",|$)",
        "fields": {
          "id": { "kind": "regex", "pattern": "cid:\"(mzc[0-9a-z]+)\"", "group": 1 },
          "title": { "kind": "regex", "pattern": "sourceTitle:\"([^\"]+)\"", "group": 1 },
          "poster": { "kind": "regex", "pattern": "smallCoverPic:\"([^\"]+)\"", "group": 1 },
          "subtitle": { "kind": "regex", "pattern": "subTitle:\"([^\"]+)\"", "group": 1 },
          "kind": { "kind": "const", "from": "video" }
        },
        "paging": { "mode": "page", "maxPage": 5 }
      },
      "episodeQuality": {
        "request": {
          "method": "GET",
          "url": "https://vv.video.qq.com/getinfo?vids={{p.vid}}&otype=json&platform=101001&charge=0"
        },
        "responseType": "json",
        "strip": { "prefix": "QZOutputJson=", "suffix": ";" },
        "root": "$.vl",
        "list": "$.vi[*]",
        "fields": {
          "id": { "kind": "jsonPath", "from": "$.vid" },
          "title": { "kind": "jsonPath", "from": "$.ti" },
          "subtitle": { "kind": "jsonPath", "from": "$.fn" },
          "playUrl": {
            "kind": "template",
            "parts": ["{{$.ul.ui[0].url}}", "{{$.fn}}", "?vkey=", "{{$.fvkey}}"],
            "rewrite": [{ "pattern": "http://[0-9]{1,3}\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}/", "replacement": "http://" }]
          },
          "duration": {
            "kind": "jsonPath",
            "from": "$.td",
            "type": "int",
            "rewrite": [{ "pattern": "(\\d+)\\.\\d+", "replacement": "$1" }]
          },
          "kind": { "kind": "const", "from": "video" }
        },
        "paging": { "mode": "page", "maxPage": 1 }
      }
    },
    "details": {
      "episode": {
        "request": {
          "method": "GET",
          "url": "https://vv.video.qq.com/getinfo?vids=&cid={{id}}&otype=json&platform=101001&charge=0"
        },
        "responseType": "json",
        "strip": { "prefix": "QZOutputJson=", "suffix": ";" },
        "root": "$.vl.vi[0]",
        "fields": {
          "id": { "kind": "jsonPath", "from": "$.vid" },
          "title": { "kind": "jsonPath", "from": "$.ti" },
          "subtitle": { "kind": "jsonPath", "from": "$.fn" },
          "playUrl": {
            "kind": "template",
            "parts": ["{{$.ul.ui[0].url}}", "{{$.fn}}", "?vkey=", "{{$.fvkey}}"],
            "rewrite": [{ "pattern": "http://[0-9]{1,3}\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}/", "replacement": "http://" }]
          },
          "duration": {
            "kind": "jsonPath",
            "from": "$.td",
            "type": "int",
            "rewrite": [{ "pattern": "(\\d+)\\.\\d+", "replacement": "$1" }]
          },
          "kind": { "kind": "const", "from": "video" }
        },
        "episodes": {
          "request": {
            "method": "POST",
            "url": "https://vd6.l.qq.com/vinfo_proxy",
            "headers": {
              "Content-Type": "text/plain",
              "Origin": "https://v.qq.com",
              "Referer": "https://v.qq.com/x/cover/{{id}}/",
              "Cookie": "video_guid=8E3C1B1F-0000-4000-8000-000000000001"
            },
            "body": "{\"cid\":\"{{id}}\",\"vid\":\"\",\"vqqcookie\":\"\",\"playParams\":{},\"vinfoParams\":{\"playerVersion\":\"1.80.0\",\"adVersion\":\"4.4.2\",\"href\":\"https://v.qq.com/x/cover/{{id}}/\",\"vinfoProtoVer\":\"9\",\"adProtoVer\":\"2026091701\"}}",
            "bodyType": "json"
          },
          "root": "$.data",
          "ids": "$.coverInfo.video_ids",
          "item": {
            "request": {
              "method": "GET",
              "url": "https://vv.video.qq.com/getinfo?vids={{episode}}&cid={{id}}&otype=json&platform=101001&charge=0"
            },
            "responseType": "json",
            "strip": { "prefix": "QZOutputJson=", "suffix": ";" },
            "root": "$.vl.vi[0]",
            "fields": {
              "title": { "kind": "jsonPath", "from": "$.ti" },
              "duration": {
                "kind": "jsonPath",
                "from": "$.td",
                "type": "int",
                "rewrite": [{ "pattern": "(\\d+)\\.\\d+", "replacement": "$1" }]
              },
              "playUrl": {
                "kind": "template",
                "parts": ["{{$.ul.ui[0].url}}", "{{$.fn}}", "?vkey=", "{{$.fvkey}}"],
                "rewrite": [{ "pattern": "http://[0-9]{1,3}\\.(?:[0-9]{1,3}\\.){2}[0-9]{1,3}/", "replacement": "http://" }]
              }
            }
          },
          "badges": [
            { "titleContains": "预告", "label": "预告", "state": "trailer" },
            { "titleContains": "彩蛋", "label": "花絮", "state": "extra" }
          ],
          "lockedPath": "$.fvkey",
          "lockedLabel": "VIP",
          "groupName": "选集",
          "maxItems": 48,
          "concurrency": 6
        }
      }
    }
  },
  "pages": [
    {
      "id": "home",
      "title": "腾讯视频",
      "layout": { "type": "poster_grid", "columns": 3, "gap": 12, "ratio": "3:4" },
      "feed": "channelChoice",
      "viewModes": ["poster_grid", "list_linear"],
      "channels": [
        { "id": "choice", "title": "首页", "feed": "channelChoice" },
        { "id": "tv", "title": "电视剧", "feed": "channelTv" },
        { "id": "movie", "title": "电影", "feed": "channelMovie" }
      ],
      "card": {
        "style": "poster",
        "image": "poster",
        "title": "title",
        "action": { "type": "detail" }
      }
    },
    {
      "id": "detail",
      "title": "视频详情",
      "layout": { "type": "detail", "resource": "episode", "ratio": "16:9", "expandLines": 4 }
    }
  ],
  "playback": {
    "strategy": "direct",
    "headers": {
      "Referer": "https://v.qq.com/",
      "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile)"
    }
  },
  "theme": {
    "mode": "dark",
    "primary": "#FF6B35",
    "background": "#0F0F13",
    "surface": "#17171C",
    "onSurface": "#E6E6EA",
    "accent": "#3DDC97",
    "cornerRadius": 12,
    "density": "comfortable",
    "posterColumns": 3,
    "fontScale": 1.0
  },
  "flags": {
    "enableSearch": false
  }
}
