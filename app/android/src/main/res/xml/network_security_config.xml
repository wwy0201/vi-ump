<?xml version="1.0" encoding="utf-8"?>
<!--
    明文流量只对"确实只提供 http 直链的媒体域"放行，不全局打开。

    起因：腾讯视频的 mp4 直链是 http（ugchwy.gtimg.com 这类 CDN 不走 https），
    而应用默认 usesCleartextTraffic=false，ExoPlayer 直接报
    [P2007] IO_CLEARTEXT_NOT_PERMITTED —— 播放器连请求都不会发出去。

    边界：
    - 只列媒体/静态资源域，API 域仍要求 https；
    - YouTube 全程 https，不需要放行；
    - 新增站点若也用 http 直链，在这里补域名，不要改成 base-config 放宽。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">gtimg.com</domain>
        <domain includeSubdomains="true">qq.com</domain>
        <domain includeSubdomains="true">qqvideo.com</domain>
        <domain includeSubdomains="true">qpic.cn</domain>
    </domain-config>

    <!--
        开发联调专用：验证 M5 的 URL 拉取导入（宿主机 python -m http.server 起一份配置 JSON）。
        10.0.2.2 是模拟器的"宿主机"别名；127.0.0.1/localhost 配 `adb reverse tcp:8765 tcp:8765` 用，
        走 adb 通道，不经过模拟器网络栈，也不会被宿主机防火墙拦。真机没有这些路由。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- lint 要求显式写 includeSubdomains；这几个都是单机地址，写 true/false 效果一样，写成 false 更贴语义 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
